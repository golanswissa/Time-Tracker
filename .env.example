# Supabase — Phase 1 cloud persistence.
# Copy to .env.local for local dev, and add the same two vars in Vercel → Settings → Environment Variables.
# The anon key is the PUBLIC key (safe in the browser, protected by row-level security).
# Never put the service_role key or any Anthropic key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
